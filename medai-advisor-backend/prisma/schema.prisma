// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 本地开发用 SQLite，上线时改为 "postgresql"
}

model User {
  id            String         @id @default(uuid()) // UUID [cite: 68]
  google_sub    String         @unique // Google 唯一ID [cite: 70]
  email         String         @unique // [cite: 71]
  name          String?        // [cite: 72]
  avatar_url    String?        // [cite: 74]
  created_at    DateTime       @default(now()) // [cite: 75]
  updated_at    DateTime       @updatedAt // [cite: 75]
  
  // 关联
  conversations Conversation[] 

  @@map("users") // 映射到真实的表名 users [cite: 67]
}

model Conversation {
  id            String         @id @default(uuid()) // [cite: 77]
  user_id       String         // FK [cite: 78]
  title         String?        // [cite: 80]
  created_at    DateTime       @default(now()) // [cite: 81]
  updated_at    DateTime       @updatedAt // [cite: 81]

  // 关联
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("conversations") // [cite: 76]
}

model Message {
  id              String       @id @default(uuid()) // [cite: 86]
  conversation_id String       // FK [cite: 87]
  role            String       // user 或 assistant [cite: 88]
  content         String       // text [cite: 89]
  created_at      DateTime     @default(now()) // [cite: 90]

  // 关联
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages") // [cite: 82]
}